{
  "name": "ascii-cinema",
  "version": "0.1.0",
  "private": true,
  "description": "ASCII Cinema Engine \u2014 prompt -> FilmSpec -> ShotSpec -> Scene -> ASCII raster -> Camera -> Remotion -> MP4",
  "type": "module",
  "main": "dist/src/cli/engine.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "node dist/src/cli/tests.js",
    "engine": "node dist/src/cli/engine.js",
    "studio": "remotion studio remotion/index.ts",
    "pipeline": "node scripts/pipeline.mjs",
    "regression:phase1": "node scripts/regression-phase1.mjs",
    "regression:phase2": "node dist/tests/regression/index.js",
    "test:all": "npm run typecheck && npm run build && npm test && npm run regression:phase2",
    "benchmarks": "node scripts/benchmarks.mjs",
    "diversity": "node scripts/diversity-report.mjs",
    "verify:all": "npm run typecheck && npm run build && npm run test && npm run pipeline",
    "materials": "node scripts/director-materials.mjs",
    "gate:phase2": "npm run typecheck && npm run build && npm run test && npm run regression:phase2 && npm run benchmarks && npm run diversity && npm run materials",
    "visual:baseline": "node scripts/visual-baseline.mjs",
    "verify:claims": "node scripts/verify-claims.mjs"
  },
  "keywords": [
    "ascii",
    "remotion",
    "procedural",
    "film",
    "generative"
  ],
  "license": "ISC",
  "dependencies": {
    "@remotion/bundler": "4.0.532",
    "@remotion/cli": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "@types/three": "^0.169.0",
    "remotion": "4.0.532",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.7.3"
  }
}
